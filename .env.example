# Copy to .env (never committed) or set these in Vercel's environment variables.
# Station sync and family mailbox (Upstash Redis, added from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ActiGraph CentrePoint API (ActiGraph enables API access and gives the client ID and secret)
ACTIGRAPH_CLIENT_ID=
ACTIGRAPH_CLIENT_SECRET=
ACTIGRAPH_STUDY_ID=
# A code of your choice that the crew types in Devices, so strangers cannot query subjects
ACTIGRAPH_PROXY_TOKEN=
# Optional: which ActiGraph algorithm settings to use
ACTIGRAPH_SLEEP_SETTING_ID=
ACTIGRAPH_MINUTE_SETTING_ID=
